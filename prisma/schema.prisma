// Prisma schema - Sistema de Locação de Equipamentos (Fisio Sono)
// Substitui a planilha de controle de pacientes, equipamentos e pagamentos.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("USER") // ADMIN | USER
  createdAt    DateTime @default(now())
}

model Patient {
  id                      String    @id @default(cuid())
  nome                    String
  cpf                     String?
  rg                      String?
  telefone                String?
  endereco                String?
  cidade                  String?
  inicioLocacao           DateTime?
  fimLocacao              DateTime?
  aparelhoLocado          String?
  identificacaoAparelho   String?
  adesaoTerapia           String? // SIM | NAO | PRE_OP
  compraCpap              String?
  dataEntregaEquipamento  DateTime?
  dispositivo             String?
  nsAparelhoEntregue      String?
  observacoes             String?
  equipmentId             String?
  equipment               Equipment? @relation(fields: [equipmentId], references: [id])
  rentalPeriods           RentalPeriod[]
  equipmentAssignments    EquipmentAssignment[]
  stockMovements          StockMovement[]
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([nome])
  @@index([cidade])
}

model Equipment {
  id               String   @id @default(cuid())
  numeroSerie      String   @unique
  tipo             String
  obs              String?
  manutencaoHoras  Int?
  tipoManutencao   String?
  dataManutencao   DateTime?
  status           String   @default("DISPONIVEL") // DISPONIVEL | EM_LOCACAO | VENDIDO | EM_MANUTENCAO
  patients         Patient[]
  assignments      EquipmentAssignment[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
  @@index([tipo])
}

/// Histórico de quais equipamentos cada paciente já usou ao longo do tempo.
model EquipmentAssignment {
  id          String     @id @default(cuid())
  patientId   String
  patient     Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  equipmentId String?
  equipment   Equipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  numeroSerie String // cópia do número de série no momento do vínculo (sobrevive à exclusão do equipamento)
  inicio      DateTime   @default(now())
  fim         DateTime? // null = ainda em uso

  @@index([patientId])
  @@index([equipmentId])
}

model RentalPeriod {
  id        String @id @default(cuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  ano       Int
  status    String @default("EM_LOCACAO") // EM_LOCACAO | FINALIZADO
  payments  MonthlyPayment[]

  @@unique([patientId, ano])
  @@index([ano])
}

model MonthlyPayment {
  id             String @id @default(cuid())
  rentalPeriodId String
  rentalPeriod   RentalPeriod @relation(fields: [rentalPeriodId], references: [id], onDelete: Cascade)
  mes               Int // 1-12
  status            String? // PAGO | PENDENTE | CORTESIA | null (sem registro)
  lembreteEnviadoEm DateTime?

  @@unique([rentalPeriodId, mes])
}

model PriceTable {
  id    String @id @default(cuid())
  ano   Int    @unique
  valor Float
}

/// Catálogo de materiais do estoque (máscaras, tubos, CPAP novo/usado à
/// venda, mentoneiras etc). Separado do Equipment, que é o inventário de
/// CPAPs de locação controlados por número de série.
model StockItem {
  id         String   @id @default(cuid())
  categoria  String // MASCARA | TUBO | CPAP_NOVO | CPAP_USADO | MENTONEIRA | OUTRO
  nome       String // ex: "Máscara Nasal Wisp - Philips Respironics", "CPAP AUTO RESMED"
  marca      String?
  quantidade Int      @default(0)
  movements  StockMovement[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([categoria, nome])
  @@index([categoria])
}

/// Histórico de entradas (chegada de material) e saídas (entregue/vendido
/// a um paciente) de cada item do estoque.
model StockMovement {
  id          String   @id @default(cuid())
  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  tipo        String // ENTRADA | SAIDA
  quantidade  Int
  motivo      String?
  patientId   String?
  patient     Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  data        DateTime @default(now())

  @@index([stockItemId])
  @@index([patientId])
}

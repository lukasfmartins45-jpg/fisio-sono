# Copie este arquivo para .env e ajuste os valores.

# Banco de dados local (SQLite)
DATABASE_URL="file:./dev.db"

# Chave usada para assinar o cookie de sessão (login).
# Gere uma nova com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="troque-esta-chave-por-uma-aleatoria-com-pelo-menos-32-caracteres"

# Lembrete de cobrança por WhatsApp (Meta Cloud API) — opcional.
# Preencha depois de criar o app no Meta for Developers e aprovar o
# template de mensagem. Sem isso, a aba Cobranças funciona normalmente,
# mas o envio falha com uma mensagem explicando o que falta.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_NAME="lembrete_pagamento"
WHATSAPP_TEMPLATE_LANG="pt_BR"

# Chave secreta que protege o endereço chamado automaticamente todo dia
# para disparar os lembretes pendentes. Gere uma nova com o mesmo comando
# do SESSION_SECRET acima.
CRON_SECRET="troque-esta-chave-tambem"

# Copie este arquivo para .env e ajuste os valores.

# Banco de dados local (SQLite)
DATABASE_URL="file:./dev.db"

# Chave usada para assinar o cookie de sessão (login).
# Gere uma nova com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="troque-esta-chave-por-uma-aleatoria-com-pelo-menos-32-caracteres"
